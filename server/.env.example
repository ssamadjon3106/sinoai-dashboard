# Postgres — Tortoise/asyncpg expects the postgres:// scheme (not postgresql://).
#
# On Vercel: use Neon's *pooled* connection string (hostname contains
# "-pooler") so many concurrent serverless invocations don't each open a raw
# Postgres connection — Neon's PgBouncer multiplexes them. Neon's dashboard
# hands you a URL with "?sslmode=require"; app/db.py rewrites that to the
# "ssl=true" query param Tortoise's asyncpg backend actually understands, so
# you can paste it in verbatim. To cap this function's own asyncpg pool size,
# append "&max_size=3" (defaults to 5 if omitted).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sinoai_dashboard

# Required — no default. Generate with: openssl rand -base64 32
# Use a different value in production than local dev.
JWT_SECRET=

# PORT is only read by `uvicorn app.main:app` for local dev — Vercel's Python
# runtime invokes the ASGI app directly, no port to bind.
PORT=8787
# Only matters for cross-origin requests. In production the frontend and API
# share one Vercel domain (see vercel.json), so CORS isn't in the request
# path at all; this is effectively local-dev-only.
CORS_ORIGIN=http://localhost:5173

# Risk overview/suggestion + weekly recommendation. Left unset, those two
# endpoints return a clear 503 instead of erroring.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Source data behind the weekly recommendation (chatapi.sinoai.io).
SINOAI_API_BASE_URL=https://chatapi.sinoai.io
SINOAI_API_KEY=
